# Copy to .env and fill in what you need. 复制成 .env 再填。
# With nothing filled in the platform still runs — the agent falls back to a
# scripted demo, so the UI and the instruction cards can still be inspected.
# 什么都不填也能跑，AI 会退化成演示剧本。

# --- The agent (pick ONE provider) / 直接做的模型（三选一）---

# Nebius Token Factory + NVIDIA Nemotron — https://studio.nebius.com
# 本项目参加 Nebius x NVIDIA 黑客松时用的就是这条
NEBIUS_API_KEY=
AGENT_PROVIDER=nebius
AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
# Other models on the same endpoint / 同一个接口下的其他模型：
#   nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B    fast and cheap / 快而便宜
#   nvidia/nemotron-3-super-120b-a12b        balanced (default) / 均衡，默认
#   nvidia/Nemotron-3-Ultra-550b-a55b        heavy reasoning / 复杂推理
# NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AGENT_MODEL=gpt-5.6-luna

# Anthropic
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5

# --- Optional / 可选 ---

# Code review in the lab bench (Anthropic only) / 实验台的 AI 评审
# REVIEW_MODEL=claude-opus-5

# Part illustration generation (Alibaba Tongyi Wanxiang) / 元件贴图生成
DASHSCOPE_API_KEY=

# Supabase — cloud storage for visitor data; without it everything stays in the browser
# 不填就存浏览器本地
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
