# 复制成 .env 然后填上你的 key（在 https://console.anthropic.com 生成）。
# 不填也能用，平台会退化成"复制提示词，自己去问 AI"。
ANTHROPIC_API_KEY=
# 可选：换评审模型
# REVIEW_MODEL=claude-opus-5

# 美术生成（通义万相）。companydata 项目的 .env.local 里有同名 key，可以复用
DASHSCOPE_API_KEY=

# Supabase（可选，体验模式访客数据云端存储；不填就存浏览器）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
